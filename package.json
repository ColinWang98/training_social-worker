{
  "name": "social-work-avatar-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "dev:all": "node scripts/dev-all.mjs",
    "dev:vite": "vite --host 127.0.0.1",
    "adk:install": "python3.11 -m venv .venv-adk && .venv-adk/bin/pip install -r adk_service/requirements.txt",
    "adk:dev": ".venv-adk/bin/python -m uvicorn adk_service.main:app --host 127.0.0.1 --port 8765",
    "adk:smoke": ".venv-adk/bin/python scripts/adk-smoke-test.py",
    "prebuild": "node scripts/copy-vad-assets.mjs",
    "smoke:sessions": ".venv-adk/bin/python scripts/session-smoke-test.py",
    "smoke:immersion": ".venv-adk/bin/python scripts/immersion-smoke-test.py",
    "smoke:methods": ".venv-adk/bin/python scripts/method-smoke-test.py",
    "client:detemplate:test": ".venv-adk/bin/python scripts/client-detemplate-test.py",
    "evaluation:pcf:test": ".venv-adk/bin/python scripts/hk-pcf-evidence-test.py",
    "evaluate:sessions": ".venv-adk/bin/python scripts/evaluate-session.py",
    "session:export": ".venv-adk/bin/python scripts/export-session.py",
    "session:replay": ".venv-adk/bin/python scripts/replay-session.py",
    "benchmark:methods": ".venv-adk/bin/python scripts/benchmark-methods.py",
    "profile:generate": ".venv-adk/bin/python scripts/generate-profile.py",
    "profile:adapt": ".venv-adk/bin/python scripts/adapt-profile.py",
    "vrma:download": "node scripts/download-vrma-candidates.mjs",
    "vrma:validate": "node scripts/validate-vrma-manifest.mjs",
    "mixamo:register": "node scripts/register-mixamo-clip.mjs",
    "mixamo:validate": "node scripts/validate-mixamo-clip.mjs",
    "mixamo:runtime:test": "node scripts/validate-mixamo-runtime.mjs",
    "avatar:motion:test": "node scripts/validate-seated-motion.mjs",
    "avatar:lip:test": "node scripts/validate-avatar-lipsync.mjs",
    "avatar:streamoji:test": "node scripts/validate-streamoji-runtime.mjs",
    "avatar:expression:test": ".venv-adk/bin/python scripts/expression-policy-test.py",
    "avatar:expression:audit": "node scripts/avatar-expression-audit.mjs --output=data/evaluations/avatar-expression-capabilities.json",
    "avatar:expression:runtime:test": "node scripts/avatar-expression-runtime-test.mjs",
    "avatar:expression:browser:test": "node scripts/avatar-expression-browser-test.mjs",
    "voice:machine:test": "node scripts/voice-machine-test.mjs",
    "voice:audio:test": "node scripts/voice-audio-worklet-test.mjs",
    "voice:queue:test": ".venv-adk/bin/python scripts/voice-audio-queue-test.py",
    "voice:boundary:test": ".venv-adk/bin/python scripts/voice-boundary-test.py",
    "voice:client:test": "node scripts/voice-client-lifecycle-test.mjs",
    "client:spoken:test": ".venv-adk/bin/python scripts/spoken-text-repair-test.py",
    "client:reaction:test": ".venv-adk/bin/python scripts/reaction-plan-test.py",
    "session:authority:test": ".venv-adk/bin/python scripts/session-authority-test.py",
    "session:api:test": ".venv-adk/bin/python scripts/session-api-test.py",
    "auth:boundary:test": "node scripts/auth-boundary-test.mjs",
    "desktop:session:test": "node scripts/desktop-session-test.mjs",
    "adk:runner:test": ".venv-adk/bin/python scripts/adk-runner-contract-test.py",
    "evaluate:reaction": ".venv-adk/bin/python scripts/evaluate-reaction-plans.py",
    "voice:tts-stream:test": ".venv-adk/bin/python scripts/voice-streaming-tts-test.py",
    "voice:policy:test": ".venv-adk/bin/python scripts/voice-policy-test.py",
    "voice:tts:smoke": ".venv-adk/bin/python scripts/tts-smoke-test.py",
    "voice:stream:test": ".venv-adk/bin/python scripts/voice-stream-state-test.py",
    "cloud:health:test": "node scripts/cloud-health-test.mjs",
    "cloud:voice:manual-check": "node scripts/cloud-voice-manual-check.mjs",
    "vrm:arkit": "node scripts/generate-arkit-proxy-vrm.mjs",
    "vrm:inspect": "node scripts/inspect-vrm-blendshapes.mjs",
    "supabase:import": ".venv-adk/bin/python scripts/import-sqlite-corpus-to-supabase.py",
    "corpus:import": "node scripts/import-hf-corpus.mjs",
    "corpus:preflight": "node scripts/corpus-preflight.mjs --sources=runtime",
    "corpus:build": "node scripts/build-corpus.mjs",
    "corpus:build:full": "node scripts/build-corpus.mjs --full --sources=runtime",
    "corpus:export": "node scripts/export-runtime-corpus.mjs",
    "corpus:export:balanced": "node scripts/export-runtime-corpus.mjs --balanced --max-per-case=3000 --max-per-source-per-case=800",
    "corpus:stats": "node scripts/corpus-stats.mjs",
    "corpus:embed": ".venv-adk/bin/python scripts/corpus-embed.py",
    "corpus:embed:stats": ".venv-adk/bin/python scripts/corpus-embed-stats.py",
    "evaluate:retrieval": ".venv-adk/bin/python scripts/evaluate-retrieval.py",
    "retrieval:stage:test": ".venv-adk/bin/python scripts/evaluate-retrieval.py",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@pixiv/three-vrm": "^3.4.2",
    "@pixiv/three-vrm-animation": "^3.4.2",
    "@ricky0123/vad-web": "^0.0.30",
    "@vitejs/plugin-react": "^5.1.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.171.0",
    "vite": "^6.0.5",
    "xstate": "^5.32.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.184.1",
    "typescript": "^5.7.2"
  }
}
